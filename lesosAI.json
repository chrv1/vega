        {"type": "formula", "as": "area_N", "expr": "hover_area_N"},
        {"type": "formula", "as": "area_E", "expr": "hover_area_E"},
        {"type": "formula", "as": "area_W", "expr": "hover_area_W"}
      ]
    },
    {
      "name": "feature_correlation",
      "url": "https://raw.githubusercontent.com/chrv1/vega/refs/heads/main/all_batches_correlation_data.csv",
      "format": {"type": "csv", "parse": "auto", "delimiter": ","},
      "transform": [{"type": "filter", "expr": "datum.epoch <= num_epochs"}]
    },
    {
      "name": "results",
      "url": "https://raw.githubusercontent.com/chrv1/vega/refs/heads/main/combined_data3.csv",
      "format": {"type": "csv", "parse": "auto", "delimiter": ","},
      "transform": [
        {"type": "filter", "expr": "datum.id <= num_points"},
        {"type": "filter", "expr": "datum.epoch == num_epochs"}
      ]
    },
    {
      "name": "E_star",
      "source": "results",
      "transform": [{"type": "extent", "field": "energy", "signal": "extent2"}]
    },
    {
      "name": "binned",
      "source": "results",
      "transform": [
        {"type": "extent", "field": "energy", "signal": "extent"},
        {
          "type": "bin",
          "field": "energy",
          "extent": {"signal": "extent"},
          "anchor": {"signal": "binOffset"},
          "step": {"signal": "binStep"},
          "nice": false
        },
        {
          "type": "aggregate",
          "key": "bin0",
          "groupby": ["bin0", "bin1"],
          "fields": ["bin0"],
          "ops": ["count"],
          "as": ["count"]
        }
      ]
    },
    {"name": "pi", "values": [{"value": 3.141592653589793}]},
