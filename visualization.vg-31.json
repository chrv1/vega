    },
    {
      "name": "data_S",
      "value": null,
      "update": " hover && isValid(hover.area_S) ? 'A: ' + hover.area_S +  ' U: ' + hover.area_S +  ' g: ' + hover.g_perp_S : ''"
    },
    {
      "name": "data_N",
      "value": "",
      "update": "hover && isValid(hover.area_N) ? 'A: ' + hover.area_N +  ' U: ' + hover.area_N +  ' g: ' + hover.g_perp_N : ''"
    },
    {
      "name": "data_E",
      "value": "",
      "update": "hover && isValid(hover.area_E) ? 'A: ' + hover.area_E +  ' U: ' + hover.area_E +  ' g: ' + hover.g_perp_E : ''"
    },
    {
      "name": "data_W",
      "value": "",
      "update": "hover && isValid(hover.area_W) ? 'A: ' + hover.area_W +  ' U: ' + hover.area_W +  ' g: ' + hover.g_perp_W : ''"
    },
    {
      "name": "hover_area_S",
      "value": "",
      "update": "hover ? hover.area_S : 10.0"
    },
    {
      "name": "hover_area_N",
      "value": "",
      "update": "hover ? hover.area_N : 10.0"
    },
    {
      "name": "hover_area_E",
      "value": "",
      "update": "hover ? hover.area_E : 10.5"
    },
    {
      "name": "hover_area_W",
      "value": "",
      "update": "hover ? hover.area_W : 10.5"
    },
    {
      "name": "hover_areas",
      "value": "",
      "update": "hover ? hover.area_W + ',' + hover.area_E + ',' + hover.area_N + ',' + hover.area_S : [10,10,10,10]"
    },
    {"name": "hover_z0", "value": "", "update": "hover ? hover.z0 : 10"},
    {"name": "hover_z1", "value": "", "update": "hover ? hover.z1 : 0"},
    {"name": "hover_width", "value": "", "update": "hover ? hover.width : 0"},
    {"name": "hover_heigth", "value": "", "update": "hover ? hover.heigth : 0"},
    {
      "name": "hover_area",
      "value": "",
      "update": "hover ? round((hover.height * hover_width -2.5)*100/(3.5*1.5-2.5)) : 0"
    },
    {
      "name": "hover_Ug",
      "value": "",
      "update": "hover ? round((hover.Ug - 0.6)*100/(1.2-0.6)) : 0"
    },
    {
      "name": "hover_gp",
      "value": "",
      "update": "hover ? round((hover.gp - 0.45) * 100 / (1.2-0.45)) : 0"
    },
    {
      "name": "hover_thickness_roofA",
      "value": "",
      "update": "hover ? round((hover.thickness_roofA - 0.15) * 100 / (0.25 - 0.15)) : 0"
    },
    {
      "name": "hover_thickness_construction_Structure",
      "value": "",
      "update": "hover ? round((hover.thickness_construction_Structure - 0.14) * 100 / (0.2-0.14)): 0"
    },
    {
      "name": "hover_thickness_construction_Insulation",
      "value": "",
      "update": "hover ? round((hover.thickness_construction_Insulation - 0.15) * 100 / (0.3-0.15)) : 0"
    },
    {
      "name": "hover_energy",
      "value": "44979.78525519",
      "update": "hover ? hover.energy : 44979.78525519"
    }
  ],
